# Root build context (spec 0058): the server image is built from here so it can
# carry migrations/. Everything the image does not need stays out, or the
# context includes the Quasar app, the docs and the integration dumps.
**/node_modules
**/dist
**/.env
**/.env.*
**/*.log

app/
docs/
integrations/
tools/
backup/
nginx/
.git/
