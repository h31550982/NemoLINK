{
  "openapi": "3.1.0",
  "info": {
    "title": "Hazmat service.",
    "version": "1.0.0",
    "description": "API for the Hazmat service.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8870",
      "description": "Hazmat service."
    }
  ],
  "paths": {
    "/api/v1/hazmat": {
      "post": {
        "operationId": "queryHazmatData",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "Hazmat"
        ],
        "summary": "Fetches hazmat data from the db. If request body is empty then all hazmat items are returned.",
        "description": "Fetches hazmat data from the db. If request body is empty then all hazmat items are returned.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HazmatQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HazmatDTO"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error fetching hazmat data."
          }
        }
      }
    },
    "/api/v1/hazmat/{undgNumber}": {
      "get": {
        "operationId": "queryHazmatDataByUNDGNumber",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "Hazmat"
        ],
        "summary": "Fetches a hazmat item from the db with UNDGNumber.",
        "description": "Fetches a hazmat item from the db with UNDGNumber.",
        "parameters": [
          {
            "name": "undgNumber",
            "in": "path",
            "required": true,
            "description": "The UNDGNumber of the hazmat item.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HazmatDTO"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Hazmat item not found."
          },
          "500": {
            "description": "Error fetching hazmat data."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HazmatDTO": {
        "$schema": "https://json-schema.org/2020-12/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "regulation": {
            "type": [
              "string",
              "null"
            ]
          },
          "editionType": {
            "type": [
              "string",
              "null"
            ]
          },
          "properShippingName": {
            "type": [
              "string",
              "null"
            ]
          },
          "hazardClass": {
            "type": [
              "string",
              "null"
            ]
          },
          "UNDGnumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "packingGroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "subsidiaryRisk": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "marinePollutionType": {
            "type": [
              "string",
              "null"
            ]
          },
          "emsNumber": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "additionalInformation": {
            "type": [
              "string",
              "null"
            ]
          },
          "flashPoint": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "carriageMode": {
            "type": [
              "string",
              "null"
            ]
          },
          "productType": {
            "type": [
              "string",
              "null"
            ]
          },
          "liquidType": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "HazmatQuery": {
        "$schema": "https://json-schema.org/2020-12/schema#",
        "type": "object",
        "properties": {
          "ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
