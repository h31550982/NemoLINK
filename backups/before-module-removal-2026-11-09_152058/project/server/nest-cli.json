{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "**/*.json",
      {
        "include": "ingest/documents/templates/*.xlsx",
        "watchAssets": true
      }
    ]
  }
}
