{
  "name": "nemo-mock",
  "private": true,
  "description": "Local mock of the NEMO Declarant API from the vendored OpenAPI spec (docs/specs/0006). Dev tool only.",
  "scripts": {
    "mock": "prism mock --host 127.0.0.1 --port 4010 ../../vendor/nemo/openapi/declarant.json",
    "mock:hazmat": "prism mock --host 127.0.0.1 --port 4012 ../../vendor/nemo/openapi/hazmat.json"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.12.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "uuid": "^11.1.1",
    "fast-xml-parser": "^5.7.0",
    "js-yaml": "^4.3.2",
    "chokidar": "^4.0.3"
  }
}
